# Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais
# ================================================================

# DatoCMS - Tokens de API
# Obtenha em: DatoCMS > Settings > API Tokens
VITE_DATO_API_TOKEN=seu_token_de_leitura_aqui
VITE_DATO_MANAGEMENT_TOKEN=seu_token_de_escrita_aqui

# Admin - Credenciais de acesso
# Configure credenciais seguras para o painel administrativo
VITE_ADMIN_USER=seu_usuario_admin
VITE_ADMIN_PASSWORD=sua_senha_forte_aqui

# Configurações do ambiente
VITE_APP_ENV=development

# ================================================================
# IMPORTANTE: 
# - Nunca commite o arquivo .env.local
# - Use senhas fortes em produção
# - Em produção, configure essas variáveis no seu provedor de hosting
# ================================================================